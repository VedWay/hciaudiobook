# Copy to backend/.env. Everything is optional: with no keys the app runs fully
# offline (lexical embeddings + answers quoted from the textbook).

# --- Providers --------------------------------------------------------------
# auto = the first of Groq, xAI, Gemini, OpenAI that has a key below; with no key, the local fallback
LLM_PROVIDER=auto            # auto | groq | xai | gemini | openai | local
EMBEDDING_PROVIDER=auto      # auto | gemini | openai | local
STT_PROVIDER=auto            # auto | groq | openai | gemini | browser   (the browser's own recogniser is always tried first)
TTS_PROVIDER=auto            # auto | edge | openai | browser   (auto = Microsoft neural voices via edge-tts)
EDGE_TTS_NARRATOR_VOICE=en-US-AvaMultilingualNeural       # list all voices:  edge-tts --list-voices
EDGE_TTS_ASSISTANT_VOICE=en-US-AndrewMultilingualNeural    # Multilingual voices also read other languages naturally

# Groq (https://console.groq.com/keys): GPT-OSS for answers and conversation, Whisper for speech recognition
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b      # or openai/gpt-oss-20b (faster, smaller)
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=qwen/qwen3.8-27b      # describes the pictures in a book when it is added (needs a model that accepts images)
DESCRIBE_PICTURES=true                  # false = pass over pictures
MAX_PICTURES_PER_BOOK=80

# xAI Grok (https://console.x.ai)
XAI_API_KEY=
XAI_LLM_MODEL=grok-4

GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=0     # 0 = fastest spoken replies; -1 = model default
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_ASSISTANT_VOICE=nova

# --- Qdrant -----------------------------------------------------------------
# Empty = embedded on-disk Qdrant in backend/data/qdrant (no server needed).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=book_chunks

# --- RAG --------------------------------------------------------------------
RETRIEVAL_TOP_K=6
ALLOW_GENERAL_KNOWLEDGE=true # may add a clearly labelled hint when the book lacks the answer

# --- Security ---------------------------------------------------------------
JWT_SECRET=                  # empty = a random secret is generated and stored in the data directory
RESEARCHER_PASSCODE=         # set this to protect participant data in the evaluation dashboard
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=40
